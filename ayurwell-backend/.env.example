# AyurWell SMTP Real Email Verification Settings
# Copy this file to .env and fill in your real SMTP email credentials (e.g. Gmail App Password)

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password
